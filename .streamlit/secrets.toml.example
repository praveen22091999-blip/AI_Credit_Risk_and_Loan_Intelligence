# ============================================================
# TEMPLATE ONLY — copy this file to secrets.toml and fill in
# real values. secrets.toml must NEVER be committed to GitHub
# (it's already excluded via .gitignore).
#
# LOCAL USE:  save as .streamlit/secrets.toml in this project folder.
# STREAMLIT CLOUD: paste the same content into
#                  App settings -> Secrets (in the Streamlit Cloud dashboard).
# ============================================================

[mysql]
host = "your-aiven-host.aivencloud.com"
port = 12345
user = "avnadmin"
password = "your-aiven-password"
database = "credit_risk_db"

[groq]
api_key = "your-groq-api-key"
